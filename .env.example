# JARVIS_BACKEND_BASE_URL: Cloud Run HTTPS endpoint for JARVIS Backend Proxy.
# Configure your real Cloud Run URL in the AI Studio Secrets panel.
JARVIS_BACKEND_BASE_URL=UNCONFIGURED_BACKEND_URL

# PORCUPINE_ACCESS_KEY: Picovoice Porcupine AccessKey for on-device "Hey Jarvis" wake-word detection.
# Configure your real AccessKey in the AI Studio Secrets panel.
PORCUPINE_ACCESS_KEY=UNCONFIGURED_PORCUPINE_KEY
