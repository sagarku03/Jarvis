# JARVIS_BACKEND_BASE_URL: Cloudflare Worker HTTPS endpoint for JARVIS Free Mode Backend Proxy.
# Configure your Worker URL (e.g., https://jarvis-worker.your-subdomain.workers.dev/) in the AI Studio Secrets panel.
JARVIS_BACKEND_BASE_URL=UNCONFIGURED_BACKEND_URL

# GOOGLE_WEB_CLIENT_ID: OAuth 2.0 Web Client ID from Firebase Authentication for Google Sign-In.
GOOGLE_WEB_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID
